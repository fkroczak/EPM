# EPM Backend – Einstellungen (liegt als /srv/epm/backend.env, nur root lesbar)
# Passwörter stehen NICHT hier, sondern in /srv/epm/secrets/
DJANGO_ALLOWED_HOSTS=epm.test,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://epm.test
DJANGO_DEBUG=0
# Verwaltung (/verwaltung/) und API-Ansicht im Browser: standardmäßig aus, ein Admin schaltet sie unter
# Administration › System für 1 oder 8 Stunden ein. EPM_DJANGO_ADMIN=0/1 bzw. EPM_API_BROWSABLE=0/1 hier legen sie fest.
# epm: verwaltung-schalter
# Automatische Abmeldung nach Minuten ohne Aktivität
EPM_SITZUNG_MINUTEN=30
GUNICORN_WORKERS=3
EPM_LOGLEVEL=INFO
