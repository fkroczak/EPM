# EPM – zentrale Einstellungen für alle Rollout-Skripte
# Für den VPS nur diese Datei anpassen, die Skripte bleiben gleich.

EPM_HOSTNAME="epm-test"            # VPS: epm
EPM_ADMIN_USER="epmadmin"          # Linux-Admin (SSH-Login)

# Verwaltungsnetz: nur von hier sind SSH und HTTPS erreichbar
EPM_MGMT_IF="enp0s8"               # Netzwerkkarte (VM: Host-only-Adapter)
EPM_MGMT_IP="192.168.56.10"        # IP dieser Karte, darauf lauscht HTTPS
EPM_MGMT_NET="192.168.56.0/24"     # erlaubtes Quellnetz (VPS: VPN-Netz der OPNsense)
EPM_SSH_PORT="22"

# Name im Browser (muss zum Zertifikat passen). Für Passkeys ein Name, keine IP (Festlegung 08.10.2026): auf der
# OPNsense per Unbound-Überschreibung auf EPM_MGMT_IP zeigen lassen, Zertifikat mit  sudo epm-zertifikat einrichten
EPM_WEB_NAME="epm.test"

# Projektverzeichnis
EPM_BASE="/srv/epm"

# Nur VPS: in der VM leer lassen
EPM_APT_PROXY=""                   # z. B. http://10.0.0.1:3128 (Squid auf der OPNsense)
EPM_NTP_SERVER=""                  # z. B. 10.0.0.1 (OPNsense)

# Woher Updates kommen: "git" = sudo epm-update holt den Code von GitHub und baut (Test-VM);
# "paket" = Server ohne Internet (VPS), nur Update-Pakete einspielen: sudo epm-update --paket DATEI
# (Paket auf der Test-VM mit  sudo epm-update --paket-erstellen  erzeugen und per scp übertragen)
EPM_UPDATE_QUELLE="git"            # VPS: paket

# Interne Docker-Netze: dürfen sich NICHT mit LAN-, VPN- oder Kundennetzen überschneiden (02-docker.sh)
EPM_DOCKER_BIP="10.231.0.1/24"
EPM_DOCKER_POOL="10.231.16.0/20"

# Sicherungen: Aufbewahrung auf dem Server in Tagen (Festlegung 02.10.2026: 30). Eine Auswahl unter Administration ›
# Backup (7, 14 oder 30 Tage, Datei /etc/epm/sicherung/aufbewahrung) geht vor.
EPM_BACKUP_TAGE="30"

# UID, unter der das Backend im Container läuft (muss zum Dockerfile passen)
EPM_APP_UID="10001"
